            }
        },
        {
            "name": "clang-libcxx-release",
            "configurePreset": "clang-libcxx-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "cuda-gcc-debug",
            "configurePreset": "cuda-gcc-debug",
            "output": {
