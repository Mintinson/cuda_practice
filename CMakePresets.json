        },
        {
            "name": "cuda-msvc-debug",
            "inherits": "windows-only-build",
            "configurePreset": "cuda-msvc-debug"
        },
        {
            "name": "cuda-msvc-release",
            "inherits": "windows-only-build",
            "configurePreset": "cuda-msvc-release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-only-test",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc-debug",
            "inherits": "windows-only-test",
            "configurePreset": "msvc-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "msvc-release",
            "inherits": "windows-only-test",
