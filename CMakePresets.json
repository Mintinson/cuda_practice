{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "mode-debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mode-release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "compiler-msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe",
                "CMAKE_CUDA_HOST_COMPILER": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe"
            },
            "environment": {
                "PATH": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64;C:/Program Files (x86)/Windows Kits/10/bin/10.0.26100.0/x64;$penv{PATH}",
                "INCLUDE": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/include;C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/ATLMFC/include;C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Auxiliary/VS/include;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/ucrt;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/um;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/shared;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/winrt;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/cppwinrt",
                "EXTERNAL_INCLUDE": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/include;C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/ATLMFC/include;C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Auxiliary/VS/include;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/ucrt;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/um;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/shared;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/winrt;C:/Program Files (x86)/Windows Kits/10/include/10.0.26100.0/cppwinrt",
                "LIB": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/ATLMFC/lib/x64;C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/lib/x64;C:/Program Files (x86)/Windows Kits/10/lib/10.0.26100.0/ucrt/x64;C:/Program Files (x86)/Windows Kits/10/lib/10.0.26100.0/um/x64",
                "VSCMD_VER": null,
                "VCINSTALLDIR": null,
                "VCToolsInstallDir": null,
                "VCToolsVersion": null,
                "VSINSTALLDIR": null,
                "VisualStudioVersion": null,
                "__VSCMD_PREINIT_VCToolsVersion": null
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "compiler-clang-cl",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang-cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "compiler-gcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "compiler-clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "compiler-clang-libcxx",
            "hidden": true,
            "inherits": "compiler-clang",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-stdlib=libc++"
            }
        },
        {
            "name": "cuda-nvcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CUDA_COMPILER": "nvcc",
                "CMAKE_CUDA_FLAGS": "--allow-unsupported-compiler"
            }
        },
        {
            "name": "cuda-clang-toolchain",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CUDA_COMPILER": "clang++"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug",
            "inherits": [
                "base",
                "compiler-msvc",
                "mode-debug"
            ]
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC Release",
            "inherits": [
                "base",
                "compiler-msvc",
                "mode-release"
            ]
        },
        {
            "name": "clang-cl-debug",
            "displayName": "clang-cl Debug",
            "inherits": [
                "base",
                "compiler-clang-cl",
                "mode-debug"
            ]
        },
        {
            "name": "clang-cl-release",
            "displayName": "clang-cl Release",
            "inherits": [
                "base",
                "compiler-clang-cl",
                "mode-release"
            ]
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug",
            "inherits": [
                "base",
                "compiler-gcc",
                "mode-debug"
            ]
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release",
            "inherits": [
                "base",
                "compiler-gcc",
                "mode-release"
            ]
        },
        {
            "name": "clang-debug",
            "displayName": "Clang Debug",
            "inherits": [
                "base",
                "compiler-clang",
                "mode-debug"
            ]
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "inherits": [
                "base",
                "compiler-clang",
                "mode-release"
            ]
        },
        {
            "name": "clang-libcxx-debug",
            "displayName": "Clang + libc++ Debug",
            "inherits": [
                "base",
                "compiler-clang-libcxx",
                "mode-debug"
            ]
        },
        {
            "name": "clang-libcxx-release",
            "displayName": "Clang + libc++ Release",
            "inherits": [
                "base",
                "compiler-clang-libcxx",
                "mode-release"
            ]
        },
        {
            "name": "cuda-gcc-debug",
            "displayName": "CUDA (GCC) Debug",
            "inherits": [
                "base",
                "compiler-gcc",
                "mode-debug",
                "cuda-nvcc"
            ]
        },
        {
            "name": "cuda-gcc-release",
            "displayName": "CUDA (GCC) Release",
            "inherits": [
                "base",
                "compiler-gcc",
                "mode-release",
                "cuda-nvcc"
            ]
        },
        {
            "name": "cuda-clang-debug",
            "displayName": "CUDA (Clang) Debug",
            "inherits": [
                "base",
                "compiler-clang",
                "mode-debug",
                "cuda-clang-toolchain"
            ]
        },
        {
            "name": "cuda-clang-release",
            "displayName": "CUDA (Clang) Release",
            "inherits": [
                "base",
                "compiler-clang",
                "mode-release",
                "cuda-clang-toolchain"
            ]
        },
        {
            "name": "cuda-msvc-debug",
            "displayName": "CUDA (MSVC) Debug",
            "inherits": [
                "base",
                "compiler-msvc",
                "mode-debug",
                "cuda-nvcc"
            ]
        },
        {
            "name": "cuda-msvc-release",
            "displayName": "CUDA (MSVC) Release",
            "inherits": [
                "base",
                "compiler-msvc",
                "mode-release",
                "cuda-nvcc"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "windows-only-build",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
